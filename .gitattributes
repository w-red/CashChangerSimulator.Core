# Handle line endings automatically for files detected as text
# and truly force CRLF on checkout on Windows.
* text=auto eol=crlf

# Explicitly set line endings for specific file types
*.cs     text eol=crlf
*.csproj text eol=crlf
*.sln    text eol=crlf
*.slnx   text eol=crlf
*.props  text eol=crlf
*.targets text eol=crlf
*.json   text eol=crlf
*.md     text eol=crlf
*.txt    text eol=crlf
*.xml    text eol=crlf
*.yml    text eol=crlf
*.yaml   text eol=crlf
*.editorconfig text eol=crlf
*.gitattributes text eol=crlf
*.gitignore text eol=crlf

# Binary files
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.dll  binary
*.pdb  binary
*.exe  binary

