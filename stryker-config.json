{
  "stryker-config": {
    "project": "src/CashChangerSimulator.Core/CashChangerSimulator.Core.csproj",
    "test-projects": [
      "test/CashChangerSimulator.Tests.csproj"
    ],
    "mutate": [
      "Services/ChangeCalculator.cs",
      "Services/CurrencyMetadataProvider.cs",
      "Services/MonitorsProvider.cs"
    ],
    "reporters": [
      "html",
      "json",
      "progress",
      "cleartext"
    ],
    "test-runner": "mtp",
    "coverage-analysis": "all",
    "concurrency": 6,
    "additional-timeout": 60000,
    "verbosity": "info",
    "ignore-mutations": [
      "linq.Skip",
      "linq.Take",
      "String"
    ]
  }
}
