{
  "stryker-config": {
    "project": "CashChangerSimulator.Device.Virtual.csproj",
    "test-projects": [
      "../../test/CashChangerSimulator.Tests.csproj"
    ],
    "mutate": [
      "DepositController.cs",
      "DispenseController.cs",
      "HardwareSimulator.cs",
      "VirtualCashChangerDevice.cs"
    ],
    "reporters": [
      "html",
      "progress",
      "cleartext"
    ],
    "test-runner": "mtp",
    "coverage-analysis": "perTest",
    "test-case-filter": "FullyQualifiedName~DepositController|FullyQualifiedName~DispenseController|FullyQualifiedName~HardwareSimulator|FullyQualifiedName~VirtualCashChangerDevice",
    "concurrency": 8,
    "additional-timeout": 30000,
    "verbosity": "info",
    "ignore-mutations": [
      "linq.Skip",
      "linq.Take",
      "String"
    ]
  }
}
