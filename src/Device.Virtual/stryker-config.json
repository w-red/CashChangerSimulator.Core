{
  "stryker-config": {
    "project": "CashChangerSimulator.Device.Virtual.csproj",
    "test-projects": [
      "../../test/CashChangerSimulator.Tests.csproj"
    ],
    "mutate": [
      "VirtualCashChangerDevice.cs",
      "HardwareSimulator.cs",
      "../CashChangerSimulator.Core/Managers/HardwareStatusManager.cs"
    ],
    "reporters": [
      "html",
      "json",
      "progress",
      "cleartext"
    ],
    "test-runner": "mtp",
    "coverage-analysis": "off",
    "test-case-filter": "FullyQualifiedName~VirtualCashChangerDeviceTests|FullyQualifiedName~HardwareSimulatorTests|FullyQualifiedName~HardwareStatusManagerTests",
    "concurrency": 6,
    "additional-timeout": 30000,
    "verbosity": "info",
    "ignore-mutations": [
      "linq.Skip",
      "linq.Take",
      "String"
    ]
  }
}
