{
  "stryker-config": {
    "project-info": {
      "name": "CashChangerSimulator.Core"
    },
    "mutate": [
      "Services/ChangeCalculator.cs",
      "Managers/HardwareStatusManager.cs",
      "Services/CurrencyMetadataProvider.cs"
    ],
    "test-case-filter": "FullyQualifiedName~ChangeCalculator|FullyQualifiedName~HardwareStatusManager|FullyQualifiedName~CurrencyMetadataProvider",
    "reporters": [
      "progress",
      "html",
      "json"
    ],
    "concurrency": 6,
    "test-runner": "mtp",
    "coverage-analysis": "perTest",
    "additional-timeout": 15000,
    "break-on-initial-test-failure": true,
    "test-projects": [
      "../../test/CashChangerSimulator.Tests.csproj"
    ],
    "verbosity": "info"
  }
}
